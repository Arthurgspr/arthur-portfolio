# ID do Google Analytics (opcional).
# Deixe em branco para manter o Analytics desativado.
# Exemplo: NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Endpoint do Formspree para o formulário de contato (opcional).
# Veja o README na seção "Formulário de contato" para instruções.
# Exemplo: NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxx
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
